DATABASE_URL=postgres://books:books@localhost:5432/books_dev
# openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Optional: Google sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email for sending invoices (your own provider)
SMTP_URL=
MAIL_FROM=
# Public address of this server, used in invite links (https://books.yourdomain.com)
APP_URL=
# Set to false once your own account exists, so nobody else can sign up
# (people you invite from Settings > Users can still create an account)
ALLOW_SIGNUP=true
# Where attachments are stored (back this up with the database)
STORAGE_DIR=./storage
