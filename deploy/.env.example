# Your domain, already pointing at this server (an A record)
DOMAIN=books.example.com
# Long random strings: openssl rand -base64 32
DB_PASSWORD=
AUTH_SECRET=
# After you've created your own account, set to false and run `docker compose up -d`
ALLOW_SIGNUP=true
# Optional, for emailing invoices: smtp://user:pass@smtp.yourprovider.com:587
SMTP_URL=
MAIL_FROM="Your Business <billing@example.com>"
# Off-site backup target for backup.sh (any rclone remote, e.g. b2:my-bucket/books). Optional.
BACKUP_REMOTE=
